    "id": "weather-api",
    "title": "Weather Query",
    "description": "Fetches live Berlin forecast from OpenMeteo and returns formatted conditions.",
    "method": "GET",
    "path": "/api/v1/weather",
    "nodes": [
      {
        "id": "trigger-w",
        "type": "httpTrigger",
        "position": {
          "x": 300,
          "y": 50
        },
        "data": {
          "title": "Weather Query",
