        },
        "measured": {
          "width": 320,
          "height": 216
        }
      },
      {
        "id": "fetch-w",
        "type": "fetchNode",
        "position": {
          "x": 300,
          "y": 320
        },
        "data": {
          "title": "OpenMeteo API",
          "method": "GET",
          "url": "https://api.open-meteo.com/v1/forecast?latitude=52.52&longitude=13.41&current_weather=true"
        },
        "measured": {
          "width": 320,
          "height": 173
        }
      },
      {
        "id": "code-w",
        "type": "codeBlock",
        "position": {
          "x": 270,
          "y": 560
        },
        "data": {
          "title": "Format Data",
          "code": "const data = state['fetch-w'] || {};\nconst current = data.current_weather || {};\n\nlog('Parsed weather data for location');\n\nreturn {\n  city: 'Berlin',\n  temperatureCelsius: current.temperature,\n  windSpeedKmh: current.windspeed,\n  timestamp: current.time\n};"
        },
        "measured": {
          "width": 384,
          "height": 263
        }
      },
      {
        "id": "resp-w",
        "type": "httpResponse",
        "position": {
          "x": 300,
          "y": 920
        },
        "data": {
          "title": "200 OK",
          "statusCode": 200,
          "bodyExpression": "state.lastResult"
        },
        "measured": {
          "width": 320,
          "height": 283
        }
      }
    ],
